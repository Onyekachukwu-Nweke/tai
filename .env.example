# Wrangler CLI authentication only. Copy to ignored .env for local deployment,
# or configure both names as repository secrets in GitHub Actions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# These values control Wrangler itself and are never application bindings.
# The token needs only the permissions required to deploy and manage TAI's
# Worker, D1 migrations, R2 bucket, Workers AI, and AI Gateway.
