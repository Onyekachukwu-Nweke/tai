# Copy to ignored .env. This is the single local secrets file for both Wrangler
# authentication and Worker runtime credentials. Never commit populated values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Worker runtime secrets used by TAI locally. Production values must be uploaded
# as encrypted Worker secrets with `wrangler secret put --env production`.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public configuration such as APP_ORIGIN, D1/R2 binding identifiers, quotas,
# AI_GATEWAY_ID, and WORKERS_AI_MODEL belongs in wrangler.toml, not this file.
# Workers AI calls use the AI binding and do not require another API token.
