{
  "name": "tai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build": "npm run build:web && wrangler deploy --dry-run --outdir dist/worker",
    "db:migrate": "wrangler d1 migrations apply tai --local",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:lines": "node scripts/check-lines.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "vitest run && vitest run --config vitest.live-evaluation-tests.config.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:lines && npm run check:links && npm run test:maintenance && npm test && npm run test:web && npm run build",
    "test:web": "playwright test",
    "postinstall": "node scripts/patch-pdf-lib.mjs",
    "prebuild": "node scripts/patch-pdf-lib.mjs",
    "pretest": "node scripts/patch-pdf-lib.mjs",
    "materials:recover": "node scripts/recover-materials.mjs",
    "test:maintenance": "node --test tests/node/*.test.mjs",
    "eval:live-ai": "vitest run --config vitest.live-evaluation.config.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "hono": "4.13.13",
    "katex": "^0.16.25",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261006.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/katex": "^0.16.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11",
    "wrangler": "4.148.0"
  },
  "packageManager": "npm@11.21.0",
  "overrides": {
    "sharp": "0.35.5"
  }
}
