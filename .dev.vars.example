# Local Worker bindings. Copy to .dev.vars; never commit populated secrets.
# Keep Wrangler's CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in .env,
# not here: they authenticate the CLI and must never reach application code.
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Whole days from 1 through 30; defaults to 3.
RETURN_GAP_DAYS=3
# Required before any model-backed operation, including fake providers.
AI_CALLS_ENABLED=true
AI_DAILY_TOTAL_LIMIT=100
AI_DAILY_CONCEPT_LIMIT=10
AI_DAILY_PACK_LIMIT=20
AI_DAILY_GRADING_LIMIT=30
AI_DAILY_SUPPORT_LIMIT=40
AI_DAILY_PRACTICAL_LIMIT=10
# Local development and automated tests stay deterministic by default.
AI_PROVIDER=fake
# Required when AI_PROVIDER=workers_ai. These are public identifiers; the AI
# binding authenticates calls, so no Workers AI or Gateway token belongs here.
AI_GATEWAY_ID=tai
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
